# Copy to .env and edit locally. Never paste API keys into chat.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
# Replace with a voice ID available to your ElevenLabs account if needed.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_STT_MODEL=scribe_v2
# English speech recognition; use auto only if you want automatic language detection.
STT_LANGUAGE=en
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Start playback while speech is being downloaded; 0 restores buffered playback.
STREAM_SPEECH=1
GEMINI_MODEL=gemini-3.5-flash
# Automatic silence detection (0 restores fixed recording).
AUTO_STOP=1
MAX_RECORD_SECONDS=15
SILENCE_SECONDS=0.6
SPEECH_WAIT_SECONDS=4
# 16-bit audio RMS level; lower for a quiet microphone, higher for background noise.
SPEECH_THRESHOLD=300
# Fixed recording duration, only used when AUTO_STOP=0 (1-30).
RECORD_SECONDS=5
# Leave blank for the Windows defaults; use --devices to find numeric IDs.
INPUT_DEVICE=
OUTPUT_DEVICE=
# Local Personal API; the default is used if this is omitted.
PERSONAL_API_URL=http://127.0.0.1:8000

GEMINI_THINKING_LEVEL=minimal
